# Raw archived source material is kept locally only, not versioned —
# these files can be large (PDFs, HTML dumps, datasets) and add no value
# to Git history. Source *records* in knowledge/sources/ (markdown
# metadata: title, URL, author, dates, path into raw_data/) ARE tracked,
# so provenance stays inspectable even though the raw content does not.
raw_data/

# Unprocessed intake dropped in by the human owner. Once Boss triages
# a file into raw_data/ + knowledge/sources/ (or an active research project),
# it's tracked there; inbox/ itself is just a local staging area.
inbox/

# System-produced exports for human consumption (reports, papers).
# Derived from the canonical wiki, which remains the system of record —
# see SYSTEM_SPEC.md §22. Not required for provenance, so not versioned.
outbox/

# Per-deployment absolute path to the repository, written by setup.sh
# into each agent workspace so agents can resolve project paths without
# relying on their working directory (see setup.sh). The same clone can
# live at a different absolute path on a different machine, so this is
# never committed.
agents/*/PROJECT_ROOT

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Local environment / secrets — nothing here today, but guard against
# accidental commits if tooling/ later needs local credentials.
.env
.env.*
*.key

# Logs and scratch output
*.log
tmp/
*.tmp

# Common tooling artifacts, in case tooling/ becomes Python or Node
__pycache__/
*.pyc
.venv/
node_modules/
